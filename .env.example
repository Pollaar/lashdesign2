# Copie para .env e ajuste (Windows: copy .env.example .env)

PORT=3000

# WhatsApp da dona do estúdio: é para ele que a cliente envia a mensagem pronta (link wa.me)
OWNER_PHONE=21972090405

# Senha do painel da dona (http://localhost:3000/admin). TROQUE por uma senha própria!
ADMIN_KEY=040417

# Até quantas semanas à frente a dona pode liberar a agenda
MAX_WEEKS_AHEAD=26

# Notificações (Web Push): um e-mail de contato seu. A Apple exige esse campo para entregar no iPhone.
VAPID_SUBJECT=mailto:seu-email@exemplo.com
# As chaves de notificação são criadas sozinhas em data/vapid.json na primeira execução.
# Se preferir, defina aqui (gere com: npx web-push generate-vapid-keys):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Nome, textos, serviços, valores, adicionais e fotos do site ficam em catalog.json
